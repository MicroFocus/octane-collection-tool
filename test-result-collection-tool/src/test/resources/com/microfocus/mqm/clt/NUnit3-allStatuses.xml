        <test-case id="1-6" name="AnotherPassingTest"
                   fullname="com.example.tests.SampleFixture.AnotherPassingTest"
                   classname="com.example.tests.SampleFixture"
                   result="Passed" duration="0.004"/>

    </test-suite>
</test-run>

